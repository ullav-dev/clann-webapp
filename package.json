{
  "name": "clann-webapp",
  "version": "1.2.0",
  "private": true,
  "scripts": {
    "dev": "node node_modules/next/dist/bin/next dev --port 3001 --webpack",
    "build": "node node_modules/next/dist/bin/next build",
    "start": "node node_modules/next/dist/bin/next start --port 3001",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "docker": "docker build --secret id=npm_token,env=NODE_AUTH_TOKEN -t clann-webapp .",
    "predocker": "docker run --rm -v \"$(pwd)\":/app -w /app -e NODE_AUTH_TOKEN=$NODE_AUTH_TOKEN node:22-alpine sh -c 'apk add --no-cache git && npm install --package-lock-only'"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.71",
    "@ai-sdk/google": "^3.0.64",
    "@ai-sdk/mistral": "^3.0.30",
    "@ai-sdk/openai": "^3.0.53",
    "@ai-sdk/openai-compatible": "^2.0.41",
    "@ai-sdk/react": "^3.0.170",
    "@tailwindcss/typography": "^0.5.19",
    "@uiw/react-md-editor": "^4.0.11",
    "@ullav/dam-picker": "file:./packages/dam-picker",
    "@xyflow/react": "^12.10.1",
    "ai": "^6.0.168",
    "html-to-image": "^1.11.13",
    "next": "16.1.6",
    "next-intl": "^4.8.3",
    "ollama-ai-provider": "^1.2.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "jsdom": "^29.1.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.0.18"
  }
}
